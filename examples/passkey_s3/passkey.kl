// ESP32-S3 NimBLE passkey/PIN bonding via klin-lang/esp_ble @v0.7.0.
// Fixed PIN 123456 — phone must enter the same code.
//   make emit && make build && make flash
import "../../esp_ble" ble

@[cexport, codename("klin_app_main")]
fn app_main_klin() {
  let mut e = ble.init()
  if e != ble.err_ok() {
    return
  }

  e = ble.bond_passkey(123456)
  if e != ble.err_ok() {
    return
  }

  e = ble.advertise("klin-pin")
  if e != ble.err_ok() {
    return
  }

  e = ble.wait_connected(120000)
  if e != ble.err_ok() {
    return
  }

  e = ble.bond_start()
  if e != ble.err_ok() {
    return
  }
  e = ble.wait_bonded(60000)
  if e != ble.err_ok() {
    return
  }

  while ble.connected() {
    let mut i: i32 = 0
    while i < 20000000 {
      i = i + 1
    }
  }
}

fn main() {
  app_main_klin()
}
