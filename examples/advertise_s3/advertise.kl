// ESP32-S3 NimBLE advertise via klin-lang/esp_ble.
//   make emit && make build && make flash
import "../../esp_ble" ble

@[cexport, codename("klin_app_main")]
fn app_main_klin() {
  let mut e = ble.init()
  if e != ble.err_ok() {
    return
  }
  e = ble.advertise("klin-ble")
  if e != ble.err_ok() {
    return
  }
  e = ble.wait_connected(120000)
  if e != ble.err_ok() {
    return
  }
  while true {
    let mut i: i32 = 0
    while i < 20000000 {
      i = i + 1
    }
  }
}

fn main() {
  app_main_klin()
}
