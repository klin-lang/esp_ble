}

pub fn gattc_uuid128(svc16: *u8, chr16: *u8): i32 {
    return klin_ble_gattc_uuid128(svc16, chr16)
}

/// Discover peer svc/chr (blocking).
pub fn gattc_discover(timeout_ms: i32): i32 {
    return klin_ble_gattc_discover(timeout_ms)
}

pub fn gattc_ready(): bool {
    return klin_ble_gattc_ready() != 0
}

pub fn gattc_read(timeout_ms: i32): i32 {
    return klin_ble_gattc_read(timeout_ms)
}

pub fn gattc_write(data: *u8, len: i32, timeout_ms: i32): i32 {
    return klin_ble_gattc_write(data, len, timeout_ms)
}

/// Enable notifications (CCCD). Peer must expose CCCD.
pub fn gattc_subscribe(timeout_ms: i32): i32 {
    return klin_ble_gattc_subscribe(timeout_ms)
}

/// Clears on read; payload via `gattc_get` / `gattc_len`.
pub fn gattc_notified(): bool {
    return klin_ble_gattc_notified() != 0
}

pub fn gattc_get(out: *mut u8, max_len: i32): i32 {
    return klin_ble_gattc_get(out, max_len)
}

pub fn gattc_len(): i32 {
    return klin_ble_gattc_len()
}

/// Just Works SM + bonding flags (keys → NVS). Call after `init`.
pub fn bond_enable(): i32 {
    return klin_ble_bond_enable()
}

/// Bonding with fixed 6-digit PIN (`0..=999999`). MITM; auto-inject on pair.
pub fn bond_passkey(passkey: i32): i32 {
    return klin_ble_bond_passkey(passkey)
}

pub fn passkey(): i32 {
    return klin_ble_passkey()
}

pub fn passkey_action(): i32 {
    return klin_ble_passkey_action()
}

pub fn passkey_inject(passkey: i32): i32 {
    return klin_ble_passkey_inject(passkey)
}

/// Start pairing/encryption on the active link.
pub fn bond_start(): i32 {
    return klin_ble_bond_start()
}

pub fn bonded(): bool {
    return klin_ble_bonded() != 0
}

pub fn wait_bonded(timeout_ms: i32): i32 {
    return klin_ble_wait_bonded(timeout_ms)
}

pub fn bond_count(): i32 {
    return klin_ble_bond_count()
}

pub fn bond_clear(): i32 {
    return klin_ble_bond_clear()
}

/// Host RPA privacy. After `init`, before advertise/scan/connect.
pub fn privacy_enable(): i32 {
    return klin_ble_privacy_enable()
}

pub fn privacy_disable(): i32 {
    return klin_ble_privacy_disable()
}

pub fn privacy_enabled(): bool {
    return klin_ble_privacy_enabled() != 0
}

pub fn own_addr_type(): i32 {
    return klin_ble_own_addr_type()
}

/// Copy 6-byte own BD_ADDR into `out6`.
pub fn own_addr(out6: *mut u8): i32 {
    return klin_ble_own_addr(out6)
}
