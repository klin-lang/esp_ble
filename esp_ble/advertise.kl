/// ESP-IDF NimBLE — thin Klin surface over `nimble_idf.c`.
/// Radio silicon + IDF NimBLE host task; Klin does not hide those costs.
/// Not part of `machine_esp`. Sibling of `esp_wifi` / `esp_eth`.
///
/// `@v0.2.0` GATT: svc `0xFFF0` / chr `0xFFF1` (R/W/Notify), max 20 bytes.
/// `@v0.3.0` central: active scan (max 16 results) + connect by index.
module esp_ble

@[link("nimble_idf.c")]
@[cinclude("nimble_idf.h")]
@[cimport, codename("klin_ble_init")]
fn klin_ble_init(): i32

@[cimport, codename("klin_ble_advertise")]
fn klin_ble_advertise(name: str): i32

@[cimport, codename("klin_ble_stop_advertise")]
fn klin_ble_stop_advertise(): i32

@[cimport, codename("klin_ble_connected")]
fn klin_ble_connected(): i32

@[cimport, codename("klin_ble_advertising")]
fn klin_ble_advertising(): i32

@[cimport, codename("klin_ble_wait_connected")]
fn klin_ble_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_ble_stop")]
fn klin_ble_stop(): i32

@[cimport, codename("klin_ble_gatt_set")]
fn klin_ble_gatt_set(data: *u8, len: i32): i32

@[cimport, codename("klin_ble_gatt_get")]
fn klin_ble_gatt_get(out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_ble_gatt_len")]
fn klin_ble_gatt_len(): i32

@[cimport, codename("klin_ble_gatt_notify")]
fn klin_ble_gatt_notify(): i32

@[cimport, codename("klin_ble_gatt_written")]
fn klin_ble_gatt_written(): i32

@[cimport, codename("klin_ble_scan_start")]
fn klin_ble_scan_start(duration_ms: i32): i32

@[cimport, codename("klin_ble_scan_stop")]
fn klin_ble_scan_stop(): i32

@[cimport, codename("klin_ble_scan_count")]
fn klin_ble_scan_count(): i32

@[cimport, codename("klin_ble_scan_rssi")]
fn klin_ble_scan_rssi(index: i32): i32

@[cimport, codename("klin_ble_scan_addr_type")]
fn klin_ble_scan_addr_type(index: i32): i32

@[cimport, codename("klin_ble_scan_addr")]
fn klin_ble_scan_addr(index: i32, out6: *mut u8): i32

@[cimport, codename("klin_ble_scan_name")]
fn klin_ble_scan_name(index: i32, out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_ble_central_connect")]
fn klin_ble_central_connect(index: i32, timeout_ms: i32): i32

@[cimport, codename("klin_ble_central_connected")]
fn klin_ble_central_connected(): i32

@[cimport, codename("klin_ble_central_wait_connected")]
fn klin_ble_central_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_ble_central_disconnect")]
fn klin_ble_central_disconnect(): i32

/// `ESP_OK` / NimBLE success (0).
pub fn err_ok(): i32 {
    return 0
}

pub fn gatt_svc_uuid16(): i32 {
    return 0xFFF0
}

pub fn gatt_chr_uuid16(): i32 {
    return 0xFFF1
}

pub fn gatt_value_max(): i32 {
    return 20
}

/// Max scan results kept (deduped by address).
pub fn scan_max(): i32 {
    return 16
}

pub fn init(): i32 {
    return klin_ble_init()
}

pub fn advertise(name: str): i32 {
    return klin_ble_advertise(name)
}

pub fn stop_advertise(): i32 {
    return klin_ble_stop_advertise()
}

/// Peripheral: a peer is connected to us.
pub fn connected(): bool {
    return klin_ble_connected() != 0
}

pub fn advertising(): bool {
    return klin_ble_advertising() != 0
}

/// Peripheral: wait until a central connects (`-1` = forever).
pub fn wait_connected(timeout_ms: i32): i32 {
    return klin_ble_wait_connected(timeout_ms)
}

pub fn stop(): i32 {
    return klin_ble_stop()
}

pub fn gatt_set(data: *u8, len: i32): i32 {
    return klin_ble_gatt_set(data, len)
}

pub fn gatt_get(out: *mut u8, max_len: i32): i32 {
    return klin_ble_gatt_get(out, max_len)
}

pub fn gatt_len(): i32 {
    return klin_ble_gatt_len()
}

pub fn gatt_notify(): i32 {
    return klin_ble_gatt_notify()
}

pub fn gatt_written(): bool {
    return klin_ble_gatt_written() != 0
}

/// Blocking active scan for `duration_ms`. Stops advertising first.
pub fn scan_start(duration_ms: i32): i32 {
    return klin_ble_scan_start(duration_ms)
}

pub fn scan_stop(): i32 {
    return klin_ble_scan_stop()
}

pub fn scan_count(): i32 {
    return klin_ble_scan_count()
}

pub fn scan_rssi(index: i32): i32 {
    return klin_ble_scan_rssi(index)
}

pub fn scan_addr_type(index: i32): i32 {
    return klin_ble_scan_addr_type(index)
}

/// Copy 6-byte BD_ADDR into `out6`.
pub fn scan_addr(index: i32, out6: *mut u8): i32 {
    return klin_ble_scan_addr(index, out6)
}

/// Copy advertised name bytes (no NUL). Returns length.
pub fn scan_name(index: i32, out: *mut u8, max_len: i32): i32 {
    return klin_ble_scan_name(index, out, max_len)
}

/// Connect as central to scan result `index` (GAP only; no GATT client yet).
pub fn central_connect(index: i32, timeout_ms: i32): i32 {
    return klin_ble_central_connect(index, timeout_ms)
}

pub fn central_connected(): bool {
    return klin_ble_central_connected() != 0
}

pub fn central_wait_connected(timeout_ms: i32): i32 {
    return klin_ble_central_wait_connected(timeout_ms)
}

pub fn central_disconnect(): i32 {
    return klin_ble_central_disconnect()
}
