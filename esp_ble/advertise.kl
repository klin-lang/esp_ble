/// ESP-IDF NimBLE — thin Klin surface over `nimble_idf.c`.
/// Radio silicon + IDF NimBLE host task; Klin does not hide those costs.
/// Not part of `machine_esp`. Sibling of `esp_wifi` / `esp_eth`.
///
/// `@v0.2.0` GATT server: svc `0xFFF0` / chr `0xFFF1` (R/W/Notify), max 20 bytes.
/// `@v0.3.0` central: active scan (max 16 results) + connect by index.
/// `@v0.4.0` GATT client: discover / read / write / subscribe on the same UUIDs.
/// `@v0.5.0` bonding: Just Works pair + NVS store (`bond_enable` / `bond_start`).
/// `@v0.6.0` custom 16-bit UUIDs via `gatt_uuid16` (before `init`).
/// `@v0.7.0` passkey/PIN bonding via `bond_passkey` (MITM).
/// `@v0.8.0` 128-bit UUID + up to 4 services (`gatt_add_*` / `gatt_*_at`).
/// `@v0.9.0` LE privacy / host RPA (`privacy_enable` before advertise/scan).
module esp_ble

@[link("nimble_idf.c")]
@[cinclude("nimble_idf.h")]
@[cimport, cheader, codename("klin_ble_init")]
fn klin_ble_init(): i32

