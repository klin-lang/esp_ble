/// `ESP_OK` / NimBLE success (0).
pub fn err_ok(): i32 {
    return 0
}

pub fn gatt_svc_uuid16(): i32 {
    return klin_ble_gatt_svc_uuid16()
}

pub fn gatt_chr_uuid16(): i32 {
    return klin_ble_gatt_chr_uuid16()
}

pub fn gatt_value_max(): i32 {
    return 20
}

/// Max scan results kept (deduped by address).
pub fn scan_max(): i32 {
    return 16
}

/// Set 16-bit svc/chr UUIDs on slot 0. Must run **before** `init`.
pub fn gatt_uuid16(svc_uuid16: i32, chr_uuid16: i32): i32 {
    return klin_ble_gatt_uuid16(svc_uuid16, chr_uuid16)
}

/// Set 128-bit svc/chr on slot 0 (16 bytes LE each). Before `init`.
pub fn gatt_uuid128(svc16: *u8, chr16: *u8): i32 {
    return klin_ble_gatt_uuid128(svc16, chr16)
}

/// Append 16-bit svc/chr (max `gatt_svc_max()`). Before `init`.
pub fn gatt_add_uuid16(svc_uuid16: i32, chr_uuid16: i32): i32 {
    return klin_ble_gatt_add_uuid16(svc_uuid16, chr_uuid16)
}

