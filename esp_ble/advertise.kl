    return klin_ble_gatt_set(data, len)
}

pub fn gatt_set_at(index: i32, data: *u8, len: i32): i32 {
    return klin_ble_gatt_set_at(index, data, len)
}

pub fn gatt_get(out: *mut u8, max_len: i32): i32 {
    return klin_ble_gatt_get(out, max_len)
}

pub fn gatt_get_at(index: i32, out: *mut u8, max_len: i32): i32 {
